# Copie para backend/.env — NUNCA commitar .env

NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Em produção:
# NODE_ENV=production
# HOST=0.0.0.0
# CORS_ORIGINS=https://seudominio.com.br
# SERVE_FRONTEND=true

# Rate limit API: 300 req / IP / minuto (site com 100+ visitas/min)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Agendamento: 30 / IP / minuto
BOOKING_RATE_WINDOW_MS=60000
BOOKING_RATE_LIMIT_MAX=30

BODY_LIMIT=10240

# openssl rand -hex 32
ADMIN_API_TOKEN=

SERVE_FRONTEND=false
FRONTEND_DIST_PATH=../frontend/dist
